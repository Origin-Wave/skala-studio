---
import IntroSection from "@components/sections/IntroSection.astro";
import type { SplitImageSectionImage } from "@components/sections/split-image-section/models";
import SplitImageSection from "@components/sections/split-image-section/SplitImageSection.astro";
import Heading from "@components/ui/typography/heading/Heading.astro";
import { HeadingSize } from "@components/ui/typography/heading/Heading.models";
import Intro from "@components/ui/typography/intro/Intro.astro";
import image1 from "@images/projects/housing-developments/1.jpg";
import image2 from "@images/projects/housing-developments/2.jpg";
import image3 from "@images/projects/housing-developments/3.jpg";

const images: SplitImageSectionImage[] = [
  {
    data: image1,
    alt: " A modern outdoor area featuring a compact outdoor kitchen with a barbecue grill and a sink, set against a wooden privacy fence and surrounded by lush greenery and mature trees.",
  },
  {
    data: image2,
    alt: "A single-storey modern house with a metal roof and vertical wooden cladding, featuring a patio area with a dining table and chairs, complemented by greenery and natural landscaping.",
  },
  {
    data: image3,
    alt: "A close-up view of a patio area with contemporary outdoor furniture, including a striped cushioned chair and large planters filled with greenery, situated against a backdrop of a modern house with vertical wooden detailing.",
  },
];
---

<div class="head">
  <IntroSection>
    <Heading as={HeadingSize.H1}>
      <u>Masterplanning</u><br /> Housing Development
    </Heading>
    <Intro>
      The Sunny Glade Estate prioritises natural light, access to green spaces,
      and thoughtfully planned layouts that foster peace and relaxation.
    </Intro>
  </IntroSection>

  <SplitImageSection images={images} />
</div>

<style lang="scss">
  .head {
    padding: var(--ss-flow-space-3) 0 0;
  }
</style>
